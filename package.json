{
  "name": "@zachthedev/dotgithub",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "audit": "bun audit --audit-level=high",
    "check": "bun --no-env-file scripts/check.ts",
    "check:rows": "bun --no-env-file scripts/check.ts --rows",
    "format": "bun x --bun --no-install prettier --config .prettierrc --no-editorconfig --ignore-path .prettierignore --write .",
    "prepare": "bun ./node_modules/lefthook/bin/index.js install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "lefthook": "2.1.17",
    "prettier": "3.9.9",
    "renovate": "44.115.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "trustedDependencies": [
    "lefthook"
  ]
}
